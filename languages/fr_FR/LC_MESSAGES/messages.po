msgid "%d Community Store product(s) currently use Appointment Store."
msgstr "%d produit(s) Community Store utilise(nt) actuellement Appointment Store."

msgid "A Community Store product option with the handle \"appointment_slot\" already exists and is not managed by Appointment Store."
msgstr "Une option de produit Community Store avec le handle « appointment_slot » existe déjà et n’est pas gérée par Appointment Store."

msgid "A booked calendar URL is required in two-calendar mode."
msgstr "Une URL de calendrier des rendez-vous réservés est requise en mode deux calendriers."

msgid "A booked calendar is required for move booking mode."
msgstr "Un calendrier des réservations est requis pour le mode de réservation par déplacement."

msgid "A booked category is required for category booking mode."
msgstr "Une catégorie pour les rendez-vous réservés est requise pour le mode de réservation par catégorie."

msgid "A password or app password is required."
msgstr "Un mot de passe ou mot de passe d’application est requis."

msgid "A valid CalDAV account is required."
msgstr "Un compte CalDAV valide est requis."

msgid "A valid Community Store product and calendar source are required."
msgstr "Un produit Community Store valide et une source de calendrier valide sont requis."

