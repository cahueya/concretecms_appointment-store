msgid "%d Community Store product(s) currently use Appointment Store."
msgstr "%d prodotto/i Community Store utilizza/no attualmente Appointment Store."

msgid "A Community Store product option with the handle \"appointment_slot\" already exists and is not managed by Appointment Store."
msgstr "Esiste già un’opzione prodotto Community Store con handle \"appointment_slot\" che non è gestita da Appointment Store."

msgid "A booked calendar URL is required in two-calendar mode."
msgstr "In modalità a due calendari è richiesto l’URL del calendario degli appuntamenti prenotati."

msgid "A booked calendar is required for move booking mode."
msgstr "Per la modalità di prenotazione con spostamento è richiesto un calendario delle prenotazioni."

msgid "A booked category is required for category booking mode."
msgstr "Per la modalità di prenotazione per categoria è richiesta una categoria per gli appuntamenti prenotati."

msgid "A password or app password is required."
msgstr "È richiesta una password o una password per app."

msgid "A valid CalDAV account is required."
msgstr "È richiesto un account CalDAV valido."

msgid "A valid Community Store product and calendar source are required."
msgstr "Sono richiesti un prodotto Community Store valido e una sorgente calendario valida."

